# 仅供 Node 后端读取。不要使用 VITE_ 前缀，不要把真实值放进仓库。
PORT=8787
HOST=127.0.0.1
# 部署时设置精确 HTTPS origin；Vite 开发时改为其真实 origin。可用逗号分隔多个；
# 本机地址的 localhost / 127.0.0.1 / [::1] 同端口自动互认
APP_ORIGIN=http://localhost:8787
# 随机生成至少 32 字符的独立后端访问口令，不能使用 OKX Secret
GLEANBOOK_ACCESS_TOKEN=
# 仅开启 Read，关闭 Trade 和 Withdraw；建议 IP 白名单
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 按账号注册地区选择官方域名，服务端只接受官方允许列表
OKX_API_ORIGIN=https://openapi.okx.com
# Node 不会自动使用 Windows 系统代理。浏览器能打开 OKX 而网站连不上时，
# 运行 npm run diagnose:okx，按提示填写本机代理端口，例如 Clash Verge 默认 7897。
# 留空：依次尝试 HTTPS_PROXY、Windows 系统代理、直连（TUN）；填 off 强制直连。
# 国内基金数据源始终直连，不经过此代理。
OKX_PROXY=
NODE_ENV=development
# 电脑主库文件夹，默认 用户目录\GleanbookData；例如放到 D 盘：GLEANBOOK_DATA_DIR=D:\GleanbookData
GLEANBOOK_DATA_DIR=
# 手机经 Tailscale 访问时的 HTTPS 地址；留空则自动从 tailscale status 读取
GLEANBOOK_PUBLIC_ORIGIN=
